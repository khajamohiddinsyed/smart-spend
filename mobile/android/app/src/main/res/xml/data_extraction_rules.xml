<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup/transfer rules (see backup_rules.xml). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="smartspend_vault.xml" />
        <exclude domain="file" path="datastore/cloud_settings.preferences_pb.migrated-v1" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="smartspend_vault.xml" />
        <exclude domain="file" path="datastore/cloud_settings.preferences_pb.migrated-v1" />
    </device-transfer>
</data-extraction-rules>
